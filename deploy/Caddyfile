# TLS termination in front of the nginx container. Caddy obtains and renews the
# certificate for $DOMAIN (HTTP-01 works through Cloudflare's proxy; set the zone's
# SSL mode to "Full (strict)"). Cloudflare's edge ranges are trusted so the visitor's
# address survives in X-Forwarded-For for the rate limiters behind; refresh the list
# from https://www.cloudflare.com/ips/ if Cloudflare changes it.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
