# Copy to .env at the repo root. Host port 5433 because 5432 is taken on the dev machine.
DATABASE_URL=postgres://tectonic:tectonic@localhost:5433/tectonic
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development
# Per-address API rate limit; 0 turns it off. Set TRUST_PROXY=true only behind nginx.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# TRUST_PROXY=false
