{
  "name": "@tectonic/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "data"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate-cli.ts",
    "ingest": "node --env-file-if-exists=../../.env --import tsx src/ingest-cli.ts",
    "geo:qfaults": "node --import tsx src/qfaults-cli.ts",
    "geo:volcanoes": "node --import tsx src/gvp-cli.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@tectonic/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@types/topojson-specification": "1.0.5",
    "@vitest/coverage-v8": "5.0.4",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
